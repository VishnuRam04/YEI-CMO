# Neon pooled connection (hostname contains `-pooler`). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@EP-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon direct connection (same endpoint without `-pooler`). Used by Prisma CLI.
DIRECT_URL="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Google AI Studio key used by @ai-sdk/google. Never expose it with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY="replace-me"

# Optional in production. Dev trace is automatically enabled by `npm run dev`.
CMO_DEV_TRACE="false"

# Optional direct research connectors used by the Analyst.
# The YouTube key comes from a Google Cloud project with YouTube Data API v3 enabled.
YOUTUBE_DATA_API_KEY=""

# Default ISO 3166-1 alpha-2 market when the CMO request does not name a country.
RESEARCH_DEFAULT_COUNTRY="MY"

# Optional Meta Ad Library access. Availability depends on Meta approval, ad category, and region.
META_AD_LIBRARY_ACCESS_TOKEN=""
META_GRAPH_API_VERSION="v24.0"

# Optional. Where generated Copywriter images are stored.
# Without it images are kept in the database and served from /api/media/[id],
# which is fine for local use. Set it to offload the bytes to blob storage.
BLOB_READ_WRITE_TOKEN="replace-me"

# Ringgit shown against the CMO's token spend. Model prices are quoted in USD,
# so this is a fixed display estimate, not a live rate. Defaults to 4.7.
NEXT_PUBLIC_MYR_PER_USD=4.7
