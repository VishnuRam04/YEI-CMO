# Neon pooled connection (hostname contains `-pooler`). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@EP-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon direct connection (same endpoint without `-pooler`). Used by Prisma CLI.
DIRECT_URL="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Google AI Studio key used by @ai-sdk/google. Never expose it with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY="replace-me"

# Vercel Blob read/write token used to store generated copywriter images.
# Text generation works without this; image mode requires it.
BLOB_READ_WRITE_TOKEN="replace-me"
