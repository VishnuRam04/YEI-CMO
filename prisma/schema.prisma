generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  url       String
  kernel    Json
  voice     Json
  /// The primary logo exactly as uploaded. Posters composite these bytes in
  /// rather than asking an image model to redraw the mark from a description,
  /// which never reproduces it faithfully.
  logoImage     Bytes?
  logoMediaType String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plans     Plan[]
  assets    Asset[]
  metrics   Metric[]
  patterns  Pattern[]
  directives StrategicDirective[]
  cmoConversations CmoConversation[]
  campaigns Campaign[]
}

model CmoConversation {
  id        String       @id @default(cuid())
  brandId   String
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  messages  CmoMessage[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([brandId, updatedAt])
}

model CmoMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   CmoConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  text           String          @db.Text
  presentation   String          @default("brief")
  response       Json?
  delegations    Json?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

/// An approved campaign: the full Strategist result plus the execution plan
/// rebuilt for whichever option the user actually chose. The Strategist only
/// ever schedules its own recommended option, so the plan is recomputed on
/// selection rather than stored once.
model Campaign {
  id               String   @id @default(cuid())
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversationId   String?
  strategyId       String   @unique
  objective        String   @db.Text
  selectedOptionId String
  status           String   @default("proposed")
  strategy         Json
  executionPlan    Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([brandId, createdAt])
}

model Plan {
  id        String     @id @default(cuid())
  brandId   String
  brand     Brand      @relation(fields: [brandId], references: [id])
  weekOf    DateTime
  createdAt DateTime   @default(now())
  items     PlanItem[]
}

model PlanItem {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  channel   String
  format    String
  hook      String
  pillar    String
  rationale String   @db.Text
  status    String   @default("idea")
  assets    Asset[]
}

model Asset {
  id         String    @id @default(cuid())
  brandId    String
  brand      Brand     @relation(fields: [brandId], references: [id])
  planItemId String?
  planItem   PlanItem? @relation(fields: [planItemId], references: [id])
  channel    String
  angle      String
  body       String    @db.Text
  mediaUrl   String?
  mediaType  String?
  /// Image bytes kept in the database when no blob store is configured, so
  /// image generation works without an external storage credential. Served
  /// through /api/media/[id]; null whenever mediaUrl points at a blob host.
  mediaData  Bytes?
  score      Int?
  subScores  Json?
  reasons    Json?
  usedKernel Boolean   @default(true)
  status     String    @default("draft")
  createdAt  DateTime  @default(now())

  @@index([brandId, createdAt])
}

model Metric {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  date        DateTime
  channel     String
  format      String
  pillar      String
  impressions Int
  clicks      Int
  spend       Float
  conversions Int
  @@index([brandId, date])
}

model Pattern {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  dimension String
  condition String
  outcome   String
  lift      Float
  n         Int
  createdAt DateTime @default(now())

  @@index([brandId, dimension])
}

model StrategicDirective {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  statement String   @db.Text
  rationale String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, active])
}
